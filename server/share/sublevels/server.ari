# The sublevels server document, run by arisrvx beside server/main.py. It publishes the sublevels
# namespace, which the Python service writes (sublevels.server.*) and native clients mirror with
# `relay: subscribe: [sublevels]`.
meta: { name: sublevels, min_libcvc: 4.0.2 }
requires: [relay, python]
server:
  publish: [sublevels]
